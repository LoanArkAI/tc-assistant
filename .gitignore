# Python
__pycache__/
*.pyc

# Never commit secrets or local env
.env
.env.*
*.key

# Context/scratch
.context/

# Full run records -- contain client data. The de-identified subset in
# metrics/runs.jsonl is committed instead. See docs/skill-ops.md.
runs/*
!runs/README.md

# Python caches from the Mac tap tests
mac-tap/**/__pycache__/
